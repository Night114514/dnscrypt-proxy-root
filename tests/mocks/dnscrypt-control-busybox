#!/bin/sh
set -u

subcommand=${1:-}
[ -n "$subcommand" ] || exit 127
shift

printf 'busybox %s %s\n' "$subcommand" "$*" >> "$MOCK_CALL_LOG"

case "$subcommand" in
  base64)
    exec "$MOCK_HOST_BASE64" "$@"
    ;;
  wget)
    output=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -O)
          shift
          output=${1:-}
          ;;
      esac
      shift
    done
    [ -n "$output" ] || exit 64
    [ "${MOCK_DOWNLOAD_MODE:-success}" = "success" ] || exit 1
    "$MOCK_HOST_CP" "$MOCK_SUBSCRIPTION_PAYLOAD" "$output"
    ;;
  flock)
    count=0
    [ ! -f "${MOCK_FLOCK_STATE:-}" ] || count=$(cat "$MOCK_FLOCK_STATE")
    if [ "$count" -lt "${MOCK_FLOCK_FAILURES:-0}" ]; then
      count=$((count + 1))
      printf '%s\n' "$count" > "$MOCK_FLOCK_STATE"
      exit 1
    fi
    exit 0
    ;;
  timeout)
    [ "$#" -ge 2 ] || exit 64
    shift
    exec "$@"
    ;;
  nc)
    # Model the local, upstream-independent Firefox canary response expected by
    # dnscrypt_local_handler_ready: TCP length, matching ID, QR+NXDOMAIN flags,
    # one question, and the original use-application-dns.net A question.
    case "${MOCK_LOCAL_HANDLER_MODE:-success}" in
      success)
        printf '\000\051\104\120\201\203\000\001\000\000\000\000\000\000\023use-application-dns\003net\000\000\001\000\001'
        exit 0
        ;;
      empty_success) exit 0 ;;
      wrong_response)
        printf '\000\051\104\121\201\203\000\001\000\000\000\000\000\000\023use-application-dns\003net\000\000\001\000\001'
        exit 0
        ;;
      wedged) exit 124 ;;
      *) exit 1 ;;
    esac
    ;;
  *)
    exit 127
    ;;
esac
