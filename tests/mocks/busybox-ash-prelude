#!/bin/sh

# BusyBox's standalone shell can resolve built-in applets before PATH. Define
# functions for the commands present in the isolated fixture so the production
# script still exercises its injected test doubles under BusyBox ash.
[ -n "${MOCK_COMMAND_DIR:-}" ] || {
  echo "MOCK_COMMAND_DIR is required" >&2
  exit 64
}

# Keep command discovery scoped to the fixture. In standalone mode BusyBox
# otherwise reports built-in applets such as wget and sha256sum even after the
# corresponding mock has intentionally been removed for a fallback test.
command() {
  [ "${1:-}" = "-v" ] && [ "$#" -eq 2 ] || return 127
  case "$2" in
    busybox) [ -x "$MOCK_COMMAND_DIR/busybox-mock" ] ;;
    *) [ -x "$MOCK_COMMAND_DIR/$2" ] ;;
  esac
}

if [ -x "$MOCK_COMMAND_DIR/awk" ]; then
  awk() { "$MOCK_COMMAND_DIR/awk" "$@"; }
fi
if [ -x "$MOCK_COMMAND_DIR/cat" ]; then
  cat() { "$MOCK_COMMAND_DIR/cat" "$@"; }
fi
if [ -x "$MOCK_COMMAND_DIR/chmod" ]; then
