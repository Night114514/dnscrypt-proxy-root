#!/bin/sh
set -u

tool_name=${MOCK_TOOL_LABEL:-${0##*/}}
output_file=
download_url=

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|-O)
      shift
      [ "$#" -gt 0 ] || exit 64
      output_file=$1
      ;;
    http://*|https://*)
      download_url=$1
      ;;
  esac
  shift
done

[ -n "$output_file" ] || exit 64
[ -n "$download_url" ] || exit 64

printf '%s %s\n' "$tool_name" "$download_url" >> "$MOCK_CALL_LOG"

case "$download_url" in
  "$MOCK_UPSTREAM_API")
    case "$MOCK_CHECKSUM_MODE" in
      match) metadata_digest="sha256:$MOCK_ACTUAL_SHA"; metadata_name="$MOCK_ASSET_NAME" ;;
      mismatch) metadata_digest='sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'; metadata_name="$MOCK_ASSET_NAME" ;;
      missing-entry) metadata_digest="sha256:$MOCK_ACTUAL_SHA"; metadata_name='dnscrypt-proxy-other.zip' ;;
      malformed-digest) metadata_digest='sha256:not-a-digest'; metadata_name="$MOCK_ASSET_NAME" ;;
      missing-digest) metadata_digest='null'; metadata_name="$MOCK_ASSET_NAME" ;;
      *) metadata_digest="sha256:$MOCK_ACTUAL_SHA"; metadata_name="$MOCK_ASSET_NAME" ;;
    esac
    case "$MOCK_METADATA_MODE" in
      success)
        printf '{\n  "tag_name": "%s",\n  "assets": [\n    {\n      "name": "%s",\n      "uploader": {"login": "fixture"},\n      "digest": "%s"\n    }\n  ]\n}\n' \
          "$MOCK_LATEST_VERSION" "$metadata_name" "$metadata_digest" > "$output_file"
        ;;
      compact)
        printf '{"tag_name":"%s","assets":[{"url":"asset","name":"%s","uploader":{"name":"fixture","note":"brace } inside string"},"digest":"%s"},{"url":"other","name":"dnscrypt-proxy-other.zip","digest":"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}]}\n' \
          "$MOCK_LATEST_VERSION" "$metadata_name" "$metadata_digest" > "$output_file"
        ;;
      wait-success)
        : > "$MOCK_WAIT_READY"
        wait_count=0
        while [ ! -f "$MOCK_WAIT_RELEASE" ]; do
          wait_count=$((wait_count + 1))
          [ "$wait_count" -le 500 ] || exit 70
          "$MOCK_HOST_SLEEP" 0.02
        done
        printf '{\n  "tag_name": "%s",\n  "assets": [\n    {\n      "name": "%s",\n      "digest": "%s"\n    }\n  ]\n}\n' \
          "$MOCK_LATEST_VERSION" "$metadata_name" "$metadata_digest" > "$output_file"
        ;;
      malformed)
        printf '{"name":"missing tag"}\n' > "$output_file"
        ;;
      fail)
        exit 22
        ;;
      *)
        exit 64
        ;;
    esac
    ;;
  *.zip)
    case "$MOCK_ASSET_MODE" in
      success)
        printf 'mock archive\n' > "$output_file"
        ;;
      fail)
        exit 22
        ;;
      *)
        exit 64
        ;;
    esac
    ;;
  *)
    exit 22
    ;;
esac
